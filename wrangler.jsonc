{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yayoi-vote-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "vars": {
    "RESULTS_EXCLUDED_OPTION_ID": "9d73a064-fb78-4ca1-b224-7bfcf5c39354"
  },
  "assets": {
    "directory": "./build",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yayoi-vote-test",
      "database_id": "fcd08594-b567-4b1d-adc9-e74c6b0c8441",
      "migrations_dir": "migrations"
    }
  ]
}
